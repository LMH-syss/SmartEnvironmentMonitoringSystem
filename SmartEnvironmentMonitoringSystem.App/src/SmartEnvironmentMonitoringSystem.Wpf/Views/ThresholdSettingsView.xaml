<UserControl x:Class="SmartEnvironmentMonitoringSystem.Wpf.Views.ThresholdSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="阈值设置" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource PanelBorderStyle}" Width="520" HorizontalAlignment="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="温度下限" VerticalAlignment="Center" Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Column="1" Text="{Binding TemperatureMin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />

                <TextBlock Grid.Row="1" Text="温度上限" VerticalAlignment="Center" Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TemperatureMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />

                <TextBlock Grid.Row="2" Text="湿度下限" VerticalAlignment="Center" Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HumidityMin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />

                <TextBlock Grid.Row="3" Text="湿度上限" VerticalAlignment="Center" Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HumidityMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />

                <TextBlock Grid.Row="4" Text="烟雾上限" VerticalAlignment="Center" Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SmokeMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />

                <TextBlock Grid.Row="5" Text="CO2 上限" VerticalAlignment="Center" Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Co2Max, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />

                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="加载" Width="110" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadCommand}" />
                    <Button Content="保存" Width="110" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
