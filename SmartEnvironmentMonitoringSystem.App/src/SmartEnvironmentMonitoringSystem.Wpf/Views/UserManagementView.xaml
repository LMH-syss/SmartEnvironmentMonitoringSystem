<UserControl x:Class="SmartEnvironmentMonitoringSystem.Wpf.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="用户管理" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="140" />
                    <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="90" />
                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="70" />
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                    <DataGridTextColumn Header="最后登录" Binding="{Binding LastLoginAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Margin="20,0,0,0" Style="{StaticResource PanelBorderStyle}">
                <StackPanel>
                    <TextBlock Text="操作" Style="{StaticResource SectionTitleText}" />
                    <Button Margin="0,18,0,0" Content="刷新列表" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadCommand}" />

                    <TextBlock Margin="0,18,0,0" Text="角色" Style="{StaticResource FieldLabelText}" />
                    <ComboBox Margin="0,6,0,0"
                              Height="38"
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}" />
                    <Button Margin="0,10,0,0" Content="保存角色" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveRoleCommand}" />

                    <TextBlock Margin="0,18,0,0" Text="账号状态" Style="{StaticResource FieldLabelText}" />
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Button Margin="0,0,6,0" Content="启用" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding EnableCommand}" />
                        <Button Margin="6,0,0,0" Content="禁用" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DisableCommand}" />
                    </UniformGrid>

                    <TextBlock Margin="0,18,0,0" Text="重置密码" Style="{StaticResource FieldLabelText}" />
                    <TextBox Text="{Binding ResetPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                    <Button Margin="0,10,0,0" Content="重置密码" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ResetPasswordCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
