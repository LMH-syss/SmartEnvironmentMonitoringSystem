<UserControl x:Class="SmartEnvironmentMonitoringSystem.Wpf.Views.CommunicationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="通信设置" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource PanelBorderStyle}" Width="540" HorizontalAlignment="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="TCP 监听 IP" VerticalAlignment="Center" Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Column="1" Text="{Binding TcpIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />

                <TextBlock Grid.Row="1" Text="TCP 端口" VerticalAlignment="Center" Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />

                <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,18,0,12" />

                <TextBlock Grid.Row="3" Text="串口号" VerticalAlignment="Center" Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SerialPortName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />

                <TextBlock Grid.Row="4" Text="波特率" VerticalAlignment="Center" Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SerialBaudRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="加载" Width="110" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadCommand}" />
                    <Button Content="保存" Width="110" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
